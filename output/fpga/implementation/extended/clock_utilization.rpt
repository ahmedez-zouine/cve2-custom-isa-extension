# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y16 [get_cells u_core/core_clock_gate_i/u_clock_buffer]

# Location of IO Primitives which is load of clock spine

# Location of clock ports

# Clock net "u_core/core_clock_gate_i/CLK" driven by instance "u_core/core_clock_gate_i/u_clock_buffer" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_u_core/core_clock_gate_i/CLK}
add_cells_to_pblock [get_pblocks  {CLKAG_u_core/core_clock_gate_i/CLK}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_core/core_clock_gate_i/CLK"}]]]
resize_pblock [get_pblocks {CLKAG_u_core/core_clock_gate_i/CLK}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0}
#endgroup
