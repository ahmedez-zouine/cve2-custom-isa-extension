####################################################################################
# Constraints from file : 'core.xdc'
####################################################################################

# 50 MHz comparison target.
create_clock -period 20.000 -name core_clk [get_ports clk_i]

# OOC interface assumption: external synchronous logic uses 20% of the period.
set_input_delay -clock core_clk -max 4.000 [get_ports -filter {DIRECTION == IN && NAME != clk_i && NAME != rst_ni}]
set_input_delay -clock core_clk -min 0.000 [get_ports -filter {DIRECTION == IN && NAME != clk_i && NAME != rst_ni}]
set _xlnx_shared_i0 [all_outputs]
set_output_delay -clock core_clk -max 4.000 $_xlnx_shared_i0
set_output_delay -clock core_clk -min 0.000 $_xlnx_shared_i0

# The external reset asserts asynchronously at the reset synchronizer.
set_false_path -from [get_ports rst_ni]


# Vivado Generated miscellaneous constraints 

#revert back to original instance
current_instance -quiet
